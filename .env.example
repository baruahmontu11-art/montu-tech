# ============================================================
# MONTU TECH — Environment variables (PLACEHOLDERS ONLY)
# Copy to .env.local for local dev. NEVER commit real secrets.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Dashboard > Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Used ONLY server-side (API routes / workers / admin). Never expose to the browser.

# --- Meta / Facebook Graph API ---
# Create the app at https://developers.facebook.com/apps
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Do NOT hardcode an API version in code — it comes from here.
META_GRAPH_API_VERSION=v21.0
# Must EXACTLY match the Valid OAuth Redirect URI in the Meta app settings.
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# Token for Meta webhook verification (choose a random string; must match Meta app settings).
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# --- Token encryption (AES-256-GCM) ---
# 32-byte key as 64 hex characters. Generate with: openssl rand -hex 32
# Server-side only. Rotating this key invalidates stored Facebook tokens
# (users must reconnect their Pages).
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Razorpay (Indian payments) ---
# Dashboard > Settings > API Keys. Test keys first, live keys only in production.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
